# Public repository allow-list. Historical working files remain local and untouched.
/*
!/.gitignore
!/.github/
!/.env.example
!/README.md
!/LICENSE
!/CITATION.cff
!/.zenodo.json
!/pyproject.toml
!/environment.yml
!/src/
!/configs/
!/data/
!/scripts/
!/tests/
!/docs/
!/release/

/data/*
!/data/small/

/scripts/*
!/scripts/download_data.py
!/scripts/verify_freeze.py
!/scripts/reproduce_tables.py
!/scripts/reproduce_figures.py
!/scripts/rerun_baselines.py
!/scripts/rerun_campaigns.py
!/scripts/build_zenodo_archive.py

/release/zenodo/*
!/release/zenodo/README.md
!/release/zenodo/MANIFEST.csv
!/release/zenodo/REDACTION_LOG.md
!/release/zenodo/LICENSE_CC_BY_4.0.txt

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.env
dist/
build/
*.egg-info/
